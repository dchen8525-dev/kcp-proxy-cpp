---
# Describes the style this repository actually uses, so `clang-format` can
# check it instead of rewriting it.
#
# The previous file was BasedOnStyle: Google with AfterFunction/AfterClass/
# AfterControlStatement = true, i.e. Allman braces:
#
#     void f()
#     {
#         if (x)
#         {
#
# while every source file here writes K&R (`void f() {`). The two had never
# agreed, so the file had never been applied -- formatting the tree with it
# would have moved thousands of lines. Verified against the tree before
# changing: 379 control/function/class open braces on the same line, 6 on the
# next line, and all 6 of those are single-statement ifs whose brace is simply
# absent.
Language: Cpp
BasedOnStyle: Google
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
AlignAfterOpenBracket: Align
# `int* x` / `const T& x`, which is what the tree writes (199 occurrences
# against 0 of `int *x` outside comments). NOTE: clang-format's Left/Right name
# the side the *symbol* attaches to, so Left is the "type-attached" spelling --
# the old `Right` here meant `int *x`, the opposite of this codebase.
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false
# The tree writes `} // namespace kcp_proxy` with one space, not Google's two.
SpacesBeforeTrailingComments: 1

# K&R: braces attach. This is the one setting that matters most -- it is what
# the old AfterFunction/AfterControlStatement: true values got wrong.
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: Empty
AllowShortLambdasOnASingleLine: Empty
# Short bodies stay on one line only when the brace is omitted entirely
# (`if (!running_) return;`), which is the form the tree uses 137 times.
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false

# Arguments and parameters are packed. The tree is mostly one-per-line when a
# signature wraps (that is what the author typed by hand), but packing scores
# noticeably closer to it in total -- measured over every source file, the
# one-per-line setting was ~500 lines further away. Neither reproduces hand
# wrapping exactly, which is expected: clang-format's job here is a single
# consistent rule, not a pixel-perfect replay of the current layout.
BinPackArguments: true
BinPackParameters: true

# Include order is the tree's, not clang-format's.
#
# With SortIncludes on, clang-format rewrites the include block of 13 of the 16
# sources: it regroups the blocks with blank lines (IncludeBlocks: Regroup) and
# sorts alphabetically inside them. Two problems, both fatal to the "the config
# describes the tree" goal:
#
#   * The regrouping alone is a large diff in files nobody meant to touch, and
#     the gate's own failure message tells people to run `clang-format -i`.
#   * More seriously, sorting inside `#if defined(_WIN32)` puts <mswsock.h>
#     BEFORE <winsock2.h> (server.cpp, kcp_client_session.cpp). mswsock.h uses
#     SOCKET and WSAIoctl without including winsock2.h -- verified against the
#     SDK header, which only pulls in winapifamily.h and mswsockdef.h -- so
#     following that advice breaks the Windows build.
#
# The order here is deliberate: project headers, then third-party, then the
# platform block that must come first for Winsock. Left unsorted, the setting
# that expressed the old intent (IncludeBlocks/IncludeCategories) is inert and
# has been removed rather than left to mislead.
SortIncludes: false

Standard: c++17
DeriveLineEnding: true
UseTab: Never
---
